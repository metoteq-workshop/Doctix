APP_NAME=Doctix
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://doctix.io
APP_TIMEZONE=UTC

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=doctix
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@doctix.io"
MAIL_FROM_NAME="${APP_NAME}"

DOCTIX_DAILY_FREE_LIMIT=4
DOCTIX_ALLOW_GUEST_TOOLS=true
DOCTIX_GUEST_DAILY_LIMIT=2
DOCTIX_FREE_MAX_FILE_SIZE_MB=25
DOCTIX_PREMIUM_MAX_FILE_SIZE_MB=250
DOCTIX_TEMP_FILE_RETENTION_HOURS=24
DOCTIX_CURRENCY=USD
DOCTIX_CURRENCY_SYMBOL=$

DOCTIX_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
